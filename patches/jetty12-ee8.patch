diff --git a/common.gradle b/common.gradle
index 6fdde38ec..412054663 100644
--- a/common.gradle
+++ b/common.gradle
@@ -1,6 +1,28 @@
 import java.nio.file.*;
 
-ext.oshCoreVersion = '2.0.3'
+// OSH core version (semantic versioning: MAJOR.MINOR.PATCH[-PRERELEASE])
+// Modules built against this core can use it as a version suffix,
+// e.g. version = withOshCoreVersion('1.2.0') -> '1.2.0-3.0.0-beta'
+ext.oshCoreVersion = '3.0.0-beta'
+
+ext.withOshCoreVersion = { moduleVersion ->
+  return moduleVersion.toString() + '-' + oshCoreVersion
+}
+
+// Converts a semantic version to a valid OSGi version (MAJOR.MINOR.MICRO[.QUALIFIER]).
+// The pre-release/build part becomes the qualifier, with characters not allowed
+// in OSGi qualifiers ('.', '+') replaced by '_' so no information is lost:
+//   3.0.0-beta       -> 3.0.0.beta
+//   1.2.0-3.0.0-beta -> 1.2.0.3_0_0-beta
+ext.toOsgiVersion = { version ->
+  def m = (version.toString() =~ /^(\d+)(?:\.(\d+))?(?:\.(\d+))?(?:[-+.](.+))?$/)
+  if (!m.matches())
+    return version.toString()
+  def osgiVersion = m.group(1) + '.' + (m.group(2) ?: '0') + '.' + (m.group(3) ?: '0')
+  if (m.group(4))
+    osgiVersion += '.' + m.group(4).replaceAll(/[^A-Za-z0-9_-]/, '_')
+  return osgiVersion
+}
 
 
